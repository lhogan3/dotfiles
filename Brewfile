# Homebrew packages for development environment
# Install with: brew bundle install --file=Brewfile

# Fonts
cask "font-jetbrains-mono-nerd-font"

# Applications
cask "ghostty"
cask "visual-studio-code"
cask "bitwarden"
cask "orbstack"
cask "raycast"

# Core CLI tools (Modern replacements)
brew "bat"              # cat replacement with syntax highlighting
brew "eza"              # ls replacement with icons and git status
brew "ripgrep"          # grep replacement (faster)
brew "fd"               # find replacement (faster)
brew "fzf"              # Fuzzy finder
brew "zoxide"           # Smart cd replacement
brew "direnv"           # Directory-specific env vars
brew "tldr"             # man pages replacement with examples

# Development tools
brew "git"
brew "git-delta"        # Git diff viewer
brew "node"
brew "python@3.14"
brew "neovim"           # vim replacement (optional)

# Utilities
brew "jq"               # JSON processor
brew "gnupg"            # GPG encryption
brew "gh"               # GitHub CLI

# Shell prompt and plugins
brew "starship"         # Prompt
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Optional: Additional tools
# brew "helix"           # Modern editor
# brew "lazygit"         # Git UI
# brew "taskwarrior"     # Task tracking
